# MongoDB
MONGO_DB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster

# Server port (optional, default 5000)
PORT=5000

# AI lesson assistant — OpenRouter (primary provider)
OPEN_ROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional fallback: direct OpenAI key when no OpenRouter key is set
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter attribution (optional)
# SITE_URL=https://yoursite.example
# SITE_NAME=Digital Life Lessons